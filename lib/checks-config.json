    { "id": "silence-outreach-run", "module": "outreach", "name": "Outreach cron actually ran - silence alarm", "type": "silence", "event": "outreach-run", "maxDays": 2 },
    { "id": "silence-etsy-visit", "module": "leads", "name": "Etsy shop checked by a session - silence alarm", "type": "silence", "event": "etsy-review", "maxDays": 7 }
