    { "id": "locked-invoicemate-sms", "module": "apps", "name": "InvoiceMate /api/send-sms refuses strangers", "type": "locked", "url": "https://tryinvoicemate.com/api/send-sms" },
    { "id": "locked-reviewmate-send", "module": "apps", "name": "ReviewMate /api/send-request refuses strangers", "type": "locked", "url": "https://getreviewmate.au/api/send-request" },
    { "id": "locked-certmate-notify", "module": "apps", "name": "CertMate /api/notify refuses strangers", "type": "locked", "url": "https://getcertmate.com/api/notify" },
    { "id": "locked-leadmate-discover", "module": "outreach", "name": "LeadMate /api/discover refuses strangers (spends Google quota)", "type": "locked", "url": "https://tryleadmate.com/api/discover" },
    { "id": "outreach-must-send-nothing", "module": "outreach", "name": "ALARM IF ANYTHING WAS SENT. INVERTED 2026-08-14 on AJ's instruction - this used to be outreach-volume-floor with min 100. All cold outreach is off, so the expected value is now 0 and ANY non-zero number means something is sending that should not be. If this fires: check vercel.json crons, OUTREACH_OFF in app/api/cron/outreach/route.ts and FOLLOWUPS_OFF in app/api/cron/followups/route.ts. Reads days.1.total NOT todayTotal, because the 19:00 UTC cron runs before the old ~21:00 UTC send slot so the last COMPLETED day is the previous UTC day. Last real send was 158 across 4 mailboxes on 2026-08-13 07:36 AEST.", "type": "json_metric", "url": "https://tryleadmate.com/api/outreach-stats?days=2", "tokenEnv": "LEADMATE_CRON_SECRET", "path": "days.1.total", "max": 0 },
    { "id": "locked-leadmate-send", "module": "outreach", "name": "LeadMate /api/send-outreach refuses strangers", "type": "locked", "url": "https://tryleadmate.com/api/send-outreach" },
    { "id": "locked-leadmate-stats", "module": "outreach", "name": "LeadMate /api/outreach-stats refuses strangers", "type": "locked", "method": "GET", "url": "https://tryleadmate.com/api/outreach-stats" },
    { "id": "outreach-guard-must-stay-on", "module": "outreach", "name": "ALARM: the outreach kill switch must stay on. Replaces locked-leadmate-outreach on 2026-08-14 at AJ's instruction. The OUTREACH_OFF guard in app/api/cron/outreach/route.ts now returns 200 with off:true to ANYONE, before the CRON_SECRET check, so the route can no longer 401 a stranger - that is deliberate, nothing can send and the public 200 is what makes this tripwire possible. off is boolean true and coerces to 1. IF SOMEONE SETS OUTREACH_OFF BACK TO false, the route falls through to the auth check, returns 401, and this check FAILS and alerts AJ.", "type": "json_metric", "url": "https://tryleadmate.com/api/cron/outreach", "path": "off", "min": 1, "max": 1 },
    { "id": "followups-guard-must-stay-on", "module": "outreach", "name": "ALARM: the follow-up kill switch must stay on. Same shape as outreach-guard-must-stay-on. FOLLOWUPS_OFF=true in app/api/cron/followups/route.ts returns 200 with off:true; set it back to false and this returns 401 and FAILS. That route sends real email via /api/send-outreach, so it needs its own tripwire.", "type": "json_metric", "url": "https://tryleadmate.com/api/cron/followups", "path": "off", "min": 1, "max": 1 },

