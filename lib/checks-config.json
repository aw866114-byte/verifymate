    { "id": "outreach-volume-floor", "module": "outreach", "name": "Outreach daily volume has not collapsed. Reads days.1.total NOT todayTotal: the 19:00 UTC cron runs BEFORE the ~21:00 UTC send, so the last COMPLETED batch is the previous UTC day. Baseline 2026-08-11 = 148 across 4 mailboxes; 2026-08-10 = 114. Floor 100 catches a collapse without firing on normal variation. Watch this after bfee52a made discover stricter.", "type": "json_metric", "url": "https://tryleadmate.com/api/outreach-stats?days=2", "tokenEnv": "LEADMATE_CRON_SECRET", "path": "days.1.total", "min": 100 },

