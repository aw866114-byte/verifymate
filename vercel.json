{
  "functions": {
    "api/verify.js": { "maxDuration": 300, "memory": 1024 },
    "api/cron/run-checks.js": { "maxDuration": 120 }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/remember", "destination": "/remember.html" }
  ],
  "crons": [
    { "path": "/api/cron/run-checks", "schedule": "0 19 * * *" },
    { "path": "/api/cron/digest", "schedule": "0 21 * * *" }
  ]
}
